  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
