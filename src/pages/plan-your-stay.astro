---
import {sitePath} from '../lib/paths';
import Layout from '../layouts/Layout.astro';import Photo from '../components/Photo.astro';import {rooms} from '../data';
---
<Layout title="Plan Your Stay">
 <section class="wrap booking-opening"><p class="eyebrow">A LITTLE TIME AWAY</p><h1>Make room<br/><em>for your stay.</em></h1><p class="demo-notice"><strong>A demonstration, from start to finish.</strong> No real availability, reservation, payment or email. Contact details stay in this page’s memory only.</p></section>
 <div class="wrap booking-layout section" data-booking data-rooms={JSON.stringify(rooms.map(({slug,name,rate})=>({slug,name,rate})))}>
 <div class="booking-main"><ol class="booking-progress" aria-label="Stay planning progress"><li aria-current="step" data-progress="0"><span>01</span> Dates</li><li data-progress="1"><span>02</span> Room</li><li data-progress="2"><span>03</span> Details</li><li data-progress="3"><span>04</span> Review</li></ol>
 <form id="stay-form" novalidate>
 <section data-step="0"><h2 tabindex="-1">When would you <em>stay?</em></h2><p>Choose your dates and who’s coming.</p><div class="form-row"><div class="field"><label for="arrival">Arrival</label><input id="arrival" name="arrival" type="date" required aria-describedby="arrival-error"/><span class="field-error" id="arrival-error"></span></div><div class="field"><label for="departure">Departure</label><input id="departure" name="departure" type="date" required aria-describedby="departure-error"/><span class="field-error" id="departure-error"></span></div></div><div class="field"><label for="adults">Adults</label><select name="adults" id="adults" aria-describedby="adults-error"><option value="2">2 adults</option><option value="1">1 adult</option></select><span class="field-error" id="adults-error"></span></div><p class="fine-print">Each room accommodates up to 2 adults. This demo models adult stays only.</p><button class="button" type="button" data-continue>Choose your room <span>→</span></button></section>
 <section data-step="1" hidden><h2 tabindex="-1">Choose your <em>corner.</em></h2><p>All four rooms are selectable for demonstration. Real availability is not connected.</p><fieldset class="booking-rooms"><legend class="sr-only">Select a room</legend>{rooms.map(r=><label class="booking-room"><input type="radio" name="room" value={r.slug} required/><Photo id={r.images[0]} sizes="180px"/><span><strong>{r.name}</strong><small>{r.area} m² · {r.floor}</small><small>{r.bed}</small><b>MAD {r.rate.toLocaleString('en')} <small>/ night · demo</small></b></span></label>)}</fieldset><span class="field-error" id="room-error" role="status"></span><div class="form-actions"><button type="button" class="back-step" data-back>← Back</button><button type="button" class="button" data-continue>Your details →</button></div></section>
 <section data-step="2" hidden><h2 tabindex="-1">A few <em>details.</em></h2><p>Try the form with example details. Nothing is sent or saved permanently.</p><div class="field"><label for="guest-name">Name</label><input id="guest-name" name="guestName" autocomplete="name" maxlength="100" required aria-describedby="guest-name-error"/><span class="field-error" id="guest-name-error"></span></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div><div class="field"><label for="note">Anything to add? <small>(optional)</small></label><textarea id="note" name="note" rows="4" maxlength="1000" placeholder="For example, a question about a transfer…"></textarea></div><p class="fine-print">Transfer requests are illustrative inquiries only. No transport is arranged.</p><div class="form-actions"><button type="button" class="back-step" data-back>← Back</button><button type="button" class="button" data-continue>Review your plan →</button></div></section>
 <section data-step="3" hidden><h2 tabindex="-1">Your time at <em>DAR SERA.</em></h2><p>Review your demonstration stay plan.</p><dl class="review-list"><div><dt>Stay</dt><dd data-review-dates></dd></div><div><dt>Room</dt><dd data-review-room></dd></div><div><dt>Guests</dt><dd data-review-guests></dd></div><div><dt>Guest</dt><dd data-review-name></dd></div><div><dt>Email</dt><dd data-review-email></dd></div><div><dt>Note</dt><dd data-review-note></dd></div><div><dt>Demo total</dt><dd data-review-total></dd></div></dl><div class="review-edit"><button type="button" data-edit="0">Edit dates</button><button type="button" data-edit="1">Change room</button><button type="button" data-edit="2">Edit details</button></div><p class="demo-notice">Completing this plan does not reserve accommodation, send an email or create a payment obligation.</p><div class="form-actions"><button type="button" class="back-step" data-back>← Back</button><button class="button" type="submit">Complete demo plan ↗</button></div></section>
 </form>
 <section class="completion" hidden data-complete><span class="completion-symbol" aria-hidden="true">✳</span><p class="eyebrow">A LITTLE SPACE, IMAGINED</p><h2 tabindex="-1">Your demo stay plan<br/><em>is ready.</em></h2><p>No reservation has been made and no payment has been taken.</p><div class="completion-summary" data-completion-summary></div><button type="button" class="button" data-copy>Copy stay summary ↗</button><p class="copy-status" data-copy-status role="status"></p><div class="field" data-copy-fallback hidden><label for="copy-summary">Copy this summary manually</label><textarea id="copy-summary" readonly rows="5"></textarea></div><button type="button" class="text-link" data-restart>Start a new plan ↗</button></section>
 <noscript><p class="demo-notice">This interactive demonstration needs JavaScript. You can still <a href={sitePath('/rooms/')}>compare all rooms</a> and <a href={sitePath('/your-stay/')}>read stay information</a>.</p></noscript>
 </div>
 <aside class="booking-aside"><Photo id={2} sizes="(max-width: 800px) 90vw, 30vw"/><div class="booking-aside-copy"><p class="eyebrow">YOUR STAY, AT A GLANCE</p><p data-summary-room>Choose your corner</p><p data-summary-dates>Select your dates</p><p data-summary-guests>2 adults</p><div class="booking-total"><span>Illustrative total</span><strong data-summary-total>—</strong></div><p class="fine-print" data-summary-math>Room and breakfast. No payment is collected.</p></div></aside>
 <p class="sr-only" aria-live="polite" data-booking-status></p>
 </div>
 <script>
 import {localDate,nightsBetween,validateDates,formatDate} from '../lib/booking.mjs';
 const root=document.querySelector<HTMLElement>('[data-booking]')!;
 const form=root.querySelector<HTMLFormElement>('form')!;
 const roomData=JSON.parse(root.dataset.rooms!) as {slug:string;name:string;rate:number}[];
 const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement;
 const arrival=field('arrival'),departure=field('departure');arrival.min=localDate();departure.min=localDate();
 let step=0;let summaryText='';
 const text=(selector:string,value:string)=>{const el=root.querySelector(selector);if(el)el.textContent=value;};
 const selectedRoom=()=>roomData.find(r=>r.slug===(form.querySelector<HTMLInputElement>('[name="room"]:checked')?.value));
 const update=()=>{const room=selectedRoom();const nights=nightsBetween(arrival.value,departure.value);const valid=Number.isFinite(nights)&&nights>0;const total=room&&valid?`MAD ${(room.rate*nights).toLocaleString('en')}`:'—';text('[data-summary-room]',room?.name||'Choose your corner');text('[data-summary-dates]',arrival.value&&departure.value?`${formatDate(arrival.value)} — ${formatDate(departure.value)}`:'Select your dates');text('[data-summary-guests]',`${field('adults').value} adult${field('adults').value==='1'?'':'s'}`);text('[data-summary-total]',total);text('[data-summary-math]',room&&valid?`${nights} night${nights===1?'':'s'} × MAD ${room.rate.toLocaleString('en')} · breakfast included · demo rate`:'Room and breakfast. No payment is collected.');text('[data-review-dates]',`${formatDate(arrival.value)} — ${formatDate(departure.value)} (${nights} nights)`);text('[data-review-room]',room?.name||'');text('[data-review-guests]',field('adults').value);text('[data-review-name]',field('guestName').value);text('[data-review-email]',field('email').value);text('[data-review-note]',field('note').value.trim()||'None');text('[data-review-total]',total);summaryText=`DAR SERA — DEMO STAY PLAN\n${room?.name||''}\n${formatDate(arrival.value)} — ${formatDate(departure.value)}\n${field('adults').value} adult(s) · ${nights} night(s)\nIllustrative total: ${total} · breakfast included\nNo reservation, payment or real availability.`;};
 const error=(name:string,message:string,id=name)=>{const el=field(name);const out=root.querySelector(`#${id}-error`);if(out)out.textContent=message;el.setAttribute('aria-invalid',String(!!message));};
 const validStep=(n:number)=>{let first:HTMLElement|null=null;if(n===0){const errors=validateDates(arrival.value,departure.value,field('adults').value) as Record<string,string>;['arrival','departure','adults'].forEach(name=>{error(name,errors[name]||'');if(errors[name]&&!first)first=field(name);});}if(n===1){const ok=!!selectedRoom();text('#room-error',ok?'':'Choose a room to continue.');if(!ok)first=form.querySelector('[name="room"]');}if(n===2){const nameOk=field('guestName').value.trim().length>0;const emailOk=field('email').value.trim().length>0&&field('email').validity.valid;error('guestName',nameOk?'':'Enter a name for your demo plan.','guest-name');error('email',emailOk?'':'Enter a valid email address.');if(!nameOk)first=field('guestName');else if(!emailOk)first=field('email');}if(first){first.focus();text('[data-booking-status]','Please check the highlighted fields.');return false;}return true;};
 const go=(n:number)=>{step=n;root.querySelectorAll<HTMLElement>('[data-step]').forEach(s=>s.hidden=Number(s.dataset.step)!==step);root.querySelectorAll<HTMLElement>('[data-progress]').forEach(p=>{if(Number(p.dataset.progress)===step)p.setAttribute('aria-current','step');else p.removeAttribute('aria-current');p.classList.toggle('done',Number(p.dataset.progress)<step);});update();root.querySelector<HTMLElement>(`[data-step="${step}"] h2`)?.focus({preventScroll:true});text('[data-booking-status]',`Step ${step+1} of 4`);};
 const preselect=new URLSearchParams(location.search).get('room');if(roomData.some(r=>r.slug===preselect)){const radio=form.querySelector<HTMLInputElement>(`[value="${preselect}"]`);if(radio)radio.checked=true;}
 form.addEventListener('input',()=>{departure.min=arrival.value||localDate();update();});form.addEventListener('change',update);
 root.querySelectorAll('[data-continue]').forEach(b=>b.addEventListener('click',()=>{if(validStep(step))go(step+1);}));root.querySelectorAll('[data-back]').forEach(b=>b.addEventListener('click',()=>go(step-1)));root.querySelectorAll<HTMLElement>('[data-edit]').forEach(b=>b.addEventListener('click',()=>go(Number(b.dataset.edit))));
 form.addEventListener('submit',e=>{e.preventDefault();if(step!==3){if(validStep(step))go(step+1);return;}for(let n=0;n<3;n++){if(!validStep(n)){go(n);return;}}update();form.hidden=true;root.querySelector<HTMLElement>('.booking-progress')!.hidden=true;root.querySelector<HTMLElement>('[data-complete]')!.hidden=false;text('[data-completion-summary]',summaryText);root.querySelector<HTMLElement>('[data-complete] h2')?.focus();});
 root.querySelector('[data-copy]')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(summaryText);text('[data-copy-status]','Stay summary copied. Contact details are not included.');}catch{root.querySelector<HTMLElement>('[data-copy-fallback]')!.hidden=false;const area=root.querySelector<HTMLTextAreaElement>('#copy-summary')!;area.value=summaryText;area.focus();area.select();text('[data-copy-status]','Select and copy the summary below.');}});
 root.querySelector('[data-restart]')!.addEventListener('click',()=>{form.reset();form.hidden=false;root.querySelector<HTMLElement>('.booking-progress')!.hidden=false;root.querySelector<HTMLElement>('[data-complete]')!.hidden=true;root.querySelector<HTMLElement>('[data-copy-fallback]')!.hidden=true;root.querySelectorAll('.field-error').forEach(e=>e.textContent='');root.querySelectorAll('[aria-invalid]').forEach(e=>e.removeAttribute('aria-invalid'));text('[data-copy-status]','');go(0);});update();
 </script>
</Layout>
