---
import Layout from '../../layouts/Layout.astro';import Photo from '../../components/Photo.astro';import Gallery from '../../components/Gallery.astro';import {rooms} from '../../data';
export function getStaticPaths(){return rooms.map(room=>({params:{slug:room.slug},props:{room}}));}
const {room}=Astro.props;const next=rooms[(rooms.findIndex(r=>r.slug===room.slug)+1)%rooms.length];
---
<Layout title={room.name} description={room.description}>
 <section class="wrap room-opening"><a href="/rooms/" class="back-link">← All four rooms</a><div class="room-title-row"><div><p class="eyebrow">ROOM {room.number} · {room.floor}</p><h1>{room.name}</h1></div><p class="room-mood">{room.mood}</p></div><div class="room-main-photo"><Photo id={room.images[0]} eager sizes="100vw"/></div></section>
 <section class="wrap section room-description"><div><p class="eyebrow">YOUR OWN CORNER</p><h2>{room.slug==='terrace-suite'?'Inside, outside.':room.slug==='light-room'?'Follow the light.':room.slug==='twin-room'?'Together, comfortably.':'A door to the courtyard.'}</h2><p>{room.description}</p><p>{room.detail}</p><div class="amenities"><span>Private shower room</span><span>Wi-Fi</span><span>Air conditioning</span><span>Linen & towels</span><span>Breakfast included</span></div><p class="access-note"><strong>Access</strong><br/>{room.access}</p></div><aside class="room-summary"><p class="eyebrow">AT A GLANCE</p><dl class="room-facts"><div><dt>Room area</dt><dd>{room.area} m²</dd></div>{room.slug==='terrace-suite'&&<div><dt>Private terrace</dt><dd>10 m²</dd></div>}<div><dt>Guests</dt><dd>Up to 2 adults</dd></div><div><dt>Bed</dt><dd>{room.bed}</dd></div><div><dt>Level</dt><dd>{room.floor}</dd></div><div><dt>Position</dt><dd>{room.slug==='courtyard-room'?'North side, courtyard facing':room.slug==='light-room'?'East side, exterior window':room.slug==='terrace-suite'?'North side, private terrace':'East side, courtyard facing'}</dd></div></dl><p class="summary-price"><small>DEMO RATE / NIGHT</small>MAD {room.rate.toLocaleString('en')}</p><a class="button" href={`/plan-your-stay/?room=${room.slug}`}>Plan your stay <span>↗</span></a><p class="fine-print">Illustrative rate. No real availability or payment.</p></aside></section>
 <Gallery images={room.images} name={room.name}/>
 <section class="wrap room-next section"><p class="eyebrow">ANOTHER CORNER OF THE HOUSE</p><a href={`/rooms/${next.slug}/`}><h2>{next.name} <span>↗</span></h2></a><p>Or <a class="underlined" href="/the-house/#house-map">find your room in the house</a>.</p></section>
</Layout>
