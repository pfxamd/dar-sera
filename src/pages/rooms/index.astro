---
import {sitePath} from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';import Photo from '../../components/Photo.astro';import {rooms} from '../../data';
---
<Layout title="Our four rooms" description="Compare the four rooms at DAR SERA: courtyard outlooks, morning light, a private terrace, and twin beds.">
 <section class="page-opening wrap"><p class="eyebrow">FOUR ROOMS · FOUR WAYS TO STAY</p><h1>Find your<br/><em>kind of quiet.</em></h1><p class="opening-description">A courtyard outlook, a window full of morning light, or a terrace of your own. Every room shares the same attention to materials and comfort.</p></section>
 <section class="wrap room-list" aria-label="All rooms">{rooms.map(room=><article class="room-list-item"><a class="room-list-image" href={sitePath(`/rooms/${room.slug}/`)}><Photo id={room.images[0]} eager={room.number==='01'} sizes="(max-width: 800px) 100vw, 55vw"/><span class="room-number">{room.number}</span></a><div class="room-list-copy"><p class="eyebrow">{room.floor} · 2 ADULTS</p><h2>{room.name}</h2><p>{room.description}</p><dl class="room-facts"><div><dt>Space</dt><dd>{room.area} m²{room.slug==='terrace-suite'?' + terrace':''}</dd></div><div><dt>Bed</dt><dd>{room.bed}</dd></div><div><dt>Outlook</dt><dd>{room.outlook}</dd></div></dl><div class="room-price"><span>Demo rate <strong>MAD {room.rate.toLocaleString('en')}</strong> / night</span><a class="text-link" href={sitePath(`/rooms/${room.slug}/`)}>Explore room <span>↗</span></a></div></div></article>)}</section>
 <section class="wrap section compare"><p class="eyebrow">AT A GLANCE</p><h2>Choose what <em>matters.</em></h2><div class="table-scroll" role="region" aria-label="Room comparison" tabindex="0"><table><caption class="sr-only">Compare room area, bed, floor and demonstration rate</caption><thead><tr><th scope="col">Room</th><th scope="col">Space</th><th scope="col">Bed</th><th scope="col">Floor</th><th scope="col">Demo rate / night</th></tr></thead><tbody>{rooms.map(r=><tr><th scope="row"><a href={sitePath(`/rooms/${r.slug}/`)}>{r.name}</a></th><td>{r.area} m²{r.slug==='terrace-suite'?' + 10 m² terrace':''}</td><td>{r.slug==='twin-room'?'Two singles':r.slug==='courtyard-room'?'Queen':'King'}</td><td>{r.floor}</td><td>MAD {r.rate.toLocaleString('en')}</td></tr>)}</tbody></table></div><p class="fine-print">All rooms accommodate up to 2 adults and include a private shower room. Rates are illustrative. Real availability is not connected.</p></section>
</Layout>
