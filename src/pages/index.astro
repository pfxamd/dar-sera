 * @repository  https://github.com/pfxamd/dar-sera
 */

import {sitePath} from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Explorer from '../components/Explorer.astro';
import {rooms} from '../data';
---
<Layout title="A quieter rhythm">
 <section class="home-opening wrap">
  <div class="opening-meta"><p class="eyebrow">A COURTYARD GUESTHOUSE</p><p class="eyebrow">35°34′ N · 5°22′ W <span class="location-note">TETOUAN CITY</span></p></div>
  <div class="opening-title"><h1>A quieter rhythm,<br/><em>inside the medina.</em></h1><div class="opening-aside"><span class="sun-mark" aria-hidden="true">✳</span><p>Four rooms, an open courtyard,<br/>and space to settle into Tetouan.</p><a class="text-link" href={sitePath('/the-house/')}>Explore the house <span>↘</span></a></div></div>
  <div class="hero-photo"><Photo id={1} eager sizes="100vw"/><span class="image-tag">THE HEART OF THE HOUSE</span><a href="#discover" class="hero-scroll" aria-label="Discover the house below">↓</a></div>
  <div class="photo-caption"><span>01 / THE COURTYARD</span><span>Open sky. A slower pace.</span></div>
 </section>
 <section class="intro wrap section" id="discover"><div class="intro-copy"><p class="eyebrow">WELCOME TO DAR SERA</p><h2>A house shaped<br/>around <em>a pause.</em></h2><p>Beyond the streets, a courtyard opens to the sky. Timber doors, cool stone and linen softened by the light. DAR SERA is an imagined four-room house, made for the simple pleasure of being somewhere.</p><a href={sitePath('/the-house/')} class="text-link">Step inside <span>↗</span></a></div><figure class="intro-photo"><Photo id={2} sizes="(max-width: 700px) 85vw, 32vw"/><figcaption>From the passage, into the light.</figcaption></figure><span class="intro-number" aria-hidden="true">04<small>ROOMS.<br/>ONE HOUSE.</small></span></section>
 <Explorer/>
 <section class="wrap section home-rooms"><div class="section-heading"><div><p class="eyebrow">ROOM TO SETTLE IN</p><h2>Different corners.<br/><em>The same calm.</em></h2></div><a href={sitePath('/rooms/')} class="text-link">Explore all four rooms <span>↗</span></a></div><div class="room-editorial">{rooms.map((room,i)=><article class:list={['room-tile',`room-tile-${i}`]}><a href={sitePath(`/rooms/${room.slug}/`)} class="room-photo"><Photo id={room.images[0]} sizes="(max-width: 700px) 95vw, 50vw"/><span class="room-number">{room.number}</span><span class="room-arrow" aria-hidden="true">↗</span></a><div class="room-tile-heading"><a href={sitePath(`/rooms/${room.slug}/`)}><h3>{room.name}</h3></a><span>{room.area} m² · 2 guests</span></div><p>{room.outlook}</p></article>)}</div></section>
 <section class="stay-story section"><div class="wrap story-grid"><div><p class="eyebrow">THE HOURS IN BETWEEN</p><h2>Nothing hurried.<br/><em>Nothing missing.</em></h2><p>Bread at the shared table. A page or two in the lounge. The afternoon moving across the rooftop. Leave a little space in your plans.</p><a class="text-link" href={sitePath('/your-stay/')}>Life at the house <span>↗</span></a><figure class="small-story"><Photo id={23} sizes="(max-width: 700px) 60vw, 24vw"/><figcaption>A simple beginning to the day.</figcaption></figure></div><figure class="large-story"><Photo id={5} sizes="(max-width: 700px) 100vw, 55vw"/><figcaption>Above the streets, under the afternoon sky.</figcaption></figure></div></section>
 <section class="destination-section wrap section"><div class="destination-copy"><p class="eyebrow">TETOUAN, NORTHERN MOROCCO</p><h2>The city<br/><em>beyond the door.</em></h2><p>White roofscapes, narrow lanes and a medina shaped by its connection to Andalusia. Begin with a walk, and let the details come to you.</p><a class="text-link" href={sitePath('/tetouan/')}>Discover Tetouan <span>↗</span></a></div><figure><Photo id={26} sizes="(max-width: 800px) 100vw, 60vw"/><figcaption>Imagined destination view · generated illustration.</figcaption></figure></section>
 <section class="stay-invitation"><div class="wrap"><p class="eyebrow">MAKE A LITTLE SPACE</p><h2>Your time.<br/><em>Your corner.</em></h2><a class="button light" href={sitePath('/plan-your-stay/')}>Plan your stay <span>↗</span></a><p class="invitation-note">Explore a demo stay. No reservation or payment.</p></div><span class="invitation-mark" aria-hidden="true">✳</span></section>
</Layout>
