---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageDescriptions } from '../data';
interface Props { id:number; class?:string; eager?:boolean; sizes?:string; }
const {id, class:className='', eager=false, sizes='(max-width: 700px) 100vw, 70vw'}=Astro.props;
const images=import.meta.glob<{default:ImageMetadata}>('../assets/images/*.webp',{eager:true});
const entry=Object.entries(images).find(([name])=>name.includes(`/${String(id).padStart(2,'0')}-`));
if(!entry) throw new Error(`Missing image ${id}`);
const src=entry[1].default;
---
<Picture src={src} formats={['avif','webp']} fallbackFormat="webp" widths={[480,960,src.width].filter((v,i,a)=>a.indexOf(v)===i && v<=src.width)} sizes={sizes} alt={imageDescriptions[id-1]} class={className} loading={eager?'eager':'lazy'} decoding="async" fetchpriority={eager?'high':'auto'} />
